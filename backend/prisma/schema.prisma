// schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CourseType {
  FRONTEND
  BACKEND
  FULLSTACK
}

// User model: both students and admins
model User {
  id             Int             @id @default(autoincrement())
  name           String
  username       String          @unique
  phoneNumber    String? // optional, can store "0990807060"
  email          String          @unique
  password       String
  role           Role
  createdAt      DateTime        @default(now())
  passwordResets PasswordReset[]

  // 🔐 Security
  passwordUpdatedAt DateTime @default(now())

  // 🧠 Student lifecycle
  status         UserStatus  @default(ACTIVE)
  currentPhase   PhaseName   @default(BEGINNER)
  specialization CourseType? // null until beginner completed

  // 📜 Relations
  usernameHist    UsernameHistory[] // track username changes
  subscriptions   Subscription[]
  progress        LessonProgress[]
  lessonsAccess   LessonAccess[]
  Transaction     Transaction[]
  MonthCompletion MonthCompletion[]
}

// Enum for role
enum Role {
  ADMIN
  STUDENT
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Keep track of username changes for students (only username is tracked)
model UsernameHistory {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  oldName   String
  newName   String
  changedAt DateTime @default(now())
}

// 1️⃣ Phase model
model Phase {
  id       Int       @id @default(autoincrement())
  name     PhaseName
  courseId Int
  course   Course    @relation(fields: [courseId], references: [id])
  months   Month[]   @relation("PhaseMonths") // add explicit relation name
}

enum PhaseName {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// 2️⃣ Course adjustment
model Course {
  id     Int    @id @default(autoincrement())
  title  String @unique
  months Int

  subscriptions Subscription[]
  phases        Phase[]
  lessons       Lesson[] // NEW relation
}

// Each month in course has weeks
model Month {
  id       Int   @id @default(autoincrement())
  monthNum Int
  phaseId  Int
  phase    Phase @relation("PhaseMonths", fields: [phaseId], references: [id])

  weeks           Week[]
  Transaction     Transaction[]
  MonthCompletion MonthCompletion[]
}

// Weeks in a month
model Week {
  id      Int      @id @default(autoincrement())
  month   Month    @relation(fields: [monthId], references: [id])
  monthId Int
  weekNum Int // 1..4
  lessons Lesson[] // NEW relation
}

// ======================= LESSON MODEL =======================
model Lesson {
  id     Int    @id @default(autoincrement())
  title  String
  weekId Int
  week   Week   @relation(fields: [weekId], references: [id])

  courseId Int
  course   Course @relation(fields: [courseId], references: [id])

  videoLinks String[] // array of YouTube/private URLs
  notesUrls  String[] // array of PDF/file URLs

  access   LessonAccess[] // which students can access
  progress LessonProgress[] // track completion
}

// Track student access to each lesson
model LessonAccess {
  id       Int    @id @default(autoincrement())
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId Int
  user     User   @relation(fields: [userId], references: [id])
  userId   Int
}

// Track student progress per lesson
model LessonProgress {
  id            Int      @id @default(autoincrement())
  user          User     @relation(fields: [userId], references: [id])
  userId        Int
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      Int
  videosWatched Boolean  @default(false)
  notesRead     Boolean  @default(false)
  updatedAt     DateTime @default(now()) @updatedAt
}

// Subscriptions for monthly access control
model Subscription {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId Int
  course Course @relation(fields: [courseId], references: [id])

  month Int

  paid Boolean @default(false)

  grantedAt DateTime @default(now())

  @@unique([userId, courseId, month])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Transaction {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  monthId Int
  month   Month @relation(fields: [monthId], references: [id])

  cohortId Int
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  status     PaymentStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  reviewedAt DateTime?
}

model MonthCompletion {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  monthId Int
  month   Month @relation(fields: [monthId], references: [id])

  cohortId Int
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  passed      Boolean   @default(false)
  evaluatedAt DateTime?

  @@unique([userId, monthId, cohortId])
}

model Cohort {
  id        Int      @id @default(autoincrement())
  name      String // e.g. "Summer 2026"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  completions   MonthCompletion[]
  transactions  Transaction[]
}
